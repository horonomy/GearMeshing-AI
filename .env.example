# Example environment file for the local Docker Compose environment (GMAI-35).
#
# Copy this file to `.env` and fill in real values. `.env` is excluded from Git (see .gitignore) —
# never commit real secrets.
#
#   cp .env.example .env
#
# See docs/local-environment.md for full documentation of each variable.

# --- PostgreSQL ---
POSTGRES_USER=gearmeshing
POSTGRES_PASSWORD=gearmeshing
POSTGRES_DB=gearmeshing
POSTGRES_PORT=5432

# --- GearMeshing-AI CLI/library ---
# Connection string assembled from the POSTGRES_* variables above by default; override only if
# pointing the gearmeshing service at a different database.
DATABASE_URL=

# Host path mounted read-only into the gearmeshing container at /app/fixtures, for fixture E2E runs
# (see GMAI-38 for the fixture repos/golden dataset that will populate this directory).
FIXTURES_DIR=./fixtures

# --- Agent Assembly runtime/gateway integration (STUBBED — no service exists in this repo yet) ---
# These are placeholders for a future Agent Assembly gateway integration. Leave blank locally.
AGENT_ASSEMBLY_GATEWAY_URL=
AGENT_ASSEMBLY_GATEWAY_TOKEN=

# --- Jira Cloud adapter (gearmeshing_ai/adapters/jira_work_management.py) ---
# JIRA_SITE_URL must be a credential-free HTTPS origin, e.g. https://your-site.atlassian.net
JIRA_SITE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Optional observability profile (docker compose --profile observability up -d) ---
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
